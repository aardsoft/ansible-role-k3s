#jinja2: lstrip_blocks: True, trim_blocks: True
apiVersion: v1
kind: Secret
metadata:
  name: cert-manager-webhook-tinydns
  namespace: "{{_k3s_cfg.cert_manager.namespace|default('cert-manager')}}"
  labels:
    app: cert-manager-webhook-tinydns
    configurator: ansible
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
type: Opaque
data:
  private.key: "{{ _webhook_private_key | b64encode }}"
