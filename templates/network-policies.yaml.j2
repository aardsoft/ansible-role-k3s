#jinja2: lstrip_blocks: True, trim_blocks: True
# {{ ansible_managed }}
# Regular namespace network policies.
#
# One "baseline" policy per namespace instead of many single-purpose
# policies: NetworkPolicy rules inside one policy union, so merging all
# policies that target ALL pods (default-deny, DNS egress, system
# namespace access, cluster-services egress, node rules) into a single
# podSelector: {} policy is semantically identical — the kernel still
# programs the same rule set either way.  Consolidation buys fewer watch
# events, a readable `kubectl get netpol`, and fewer objects.  Policies
# with podSelectors that do NOT match all pods (cluster-service, dmz, zone
# labels) stay separate because merging them would widen their rule
# targets.
{% for _namespace in _np_namespaces | default([]) %}
---
# baseline: default-deny + everything targeting all pods.
# policyTypes lists both directions, so ingress/egress not whitelisted below
# is denied — that IS the default-deny posture; no separate default-deny-all
# object is needed.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: baseline
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  - Egress
{% if _np_cfg.system_namespaces | default([]) | length > 0 %}
  # pods in system namespaces (registry, metrics, ...) may initiate
  # connections
  ingress:
  - from:
  {% for _sysns in _np_cfg.system_namespaces | default([]) %}
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ _sysns }}
  {% endfor %}
{% endif %}
  egress:
  # DNS resolution is always required
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
      podSelector:
        matchLabels:
          k8s-app: kube-dns
    ports:
    - port: 53
      protocol: UDP
    - port: 53
      protocol: TCP
  {% for _sysns in _np_cfg.system_namespaces | default([]) %}
  # system namespace {{ _sysns }}: full access.  API-server traffic does NOT
  # land here (its DNATed destination is the node IP, see the api-server
  # opt-in policy below) — these are for pod-backed services like registry,
  # metrics-server, longhorn API.
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ _sysns }}
  {% endfor %}
  # in-cluster pods labeled network/cluster-service (victorialogs, authelia,
  # headlamp, ...)
  - to:
    - namespaceSelector: {}
      podSelector:
        matchLabels:
          network/cluster-service: "true"
  # NO node-CIDR/API egress here: the Kubernetes API is reached post-DNAT via
  # the node CIDR (kube-proxy DNATs the ClusterIP, e.g. 10.43.0.1:443 ->
  # 172.31.248.x:6443), and granting that from the blanket baseline would
  # expose node mgmt IPs (SSH included) to every pod.  Few pods legitimately
  # need the API — operators/controllers mostly — so it is a per-pod opt-in:
  # see the allow-api-server-egress policy below.
---
# cluster-service pods: reachable from any pod in the cluster
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-cluster-services-ingress
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector:
    matchLabels:
      network/cluster-service: "true"
  policyTypes:
  - Ingress
  ingress:
  - from:
    - namespaceSelector: {}
      podSelector: {}
{% if _np_cfg.k3s_cidrs | default([]) | length > 0 %}
{% set _np_api_node_port = _np_cfg.api_node_port | default(6443) %}
---
# api-server opt-in: egress for pods labeled network/api-server.
# The Kubernetes API is reachable post-DNAT via the node CIDR — kube-proxy
# DNATs the kubernetes service ClusterIP to a node IP and destinations are
# evaluated post-DNAT, so the effective destination is node IP +
# api_node_port (default 6443; e.g. 10.43.0.1:443 -> 172.31.248.x:6443 — a
# tcp/443 rule would never match).  Not part of the blanket baseline: node
# mgmt IPs share the CIDR (SSH included), and very few pods legitimately
# need the API — typically operators/controllers and anything doing API
# auth itself (CRDs, leader election).  Opt in via network_policy_labels:
# [api-server].  Host-network non-API services would be a separate opt-in,
# not a widening here.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-api-server-egress
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector:
    matchLabels:
      network/api-server: "true"
  policyTypes:
  - Egress
  egress:
  - to:
  {% for _node_cidr in _np_cfg.k3s_cidrs %}
    - ipBlock:
        cidr: {{ _node_cidr }}
  {% endfor %}
    ports:
    - port: {{ _np_api_node_port }}
      protocol: TCP
{% endif %}
{% if _np_cfg.dmz_cidrs | default([]) | length > 0 %}
{% set _k3s_ipv4 = _np_cfg.k3s_cidrs | default([]) | ansible.utils.ipv4 | list %}
{% set _k3s_ipv6 = _np_cfg.k3s_cidrs | default([]) | ansible.utils.ipv6 | list %}
---
# DMZ: ingress from DMZ CIDRs.
# Kept separate from the egress policy so ingress-only or egress-only DMZ
# setups remain expressible (stateful tracking covers replies to allowed
# ingress, but DMZ pods also INITIATE connections to DMZ CIDRs).
# Source IP note: with MetalLB externalTrafficPolicy Cluster (default), pods
# see node IPs as source rather than the real client IP; use
# externalTrafficPolicy: Local for accurate source IP matching.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-dmz-ingress
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector:
    matchLabels:
      network/dmz: "true"
  policyTypes:
  - Ingress
  ingress:
  - from:
  {% for cidr in _np_cfg.dmz_cidrs %}
    - ipBlock:
        cidr: {{ cidr }}
  {% endfor %}
---
# DMZ: egress to DMZ CIDRs, excluding cluster-internal node CIDRs
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-dmz-egress
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector:
    matchLabels:
      network/dmz: "true"
  policyTypes:
  - Egress
  egress:
  - to:
  {% for cidr in _np_cfg.dmz_cidrs %}
  {% set _excl = _k3s_ipv6 if ':' in cidr else _k3s_ipv4 %}
    - ipBlock:
        cidr: {{ cidr }}
  {% if _excl | length > 0 %}
        except:
    {% for excl in _excl %}
        - {{ excl }}
    {% endfor %}
  {% endif %}
  {% endfor %}
{% endif %}
{% for _area_name, _area in (_np_cfg.access_areas | default({})).items() %}
{% if _area.cidrs | default([], true) | length > 0 %}
---
# {{ _area_name }}: ingress for CIDR-based access area.
# access_areas entries are named client-CIDR sets, independent of VLANs or
# namespaces — the generic counterpart of dmz_cidrs/service_vlans.  LB
# address pools reference their client area via metallb.pools.<pool>
# .access_area (entrypoints whose name matches a pool derive the same area
# automatically); pods opt in with the network/{{ _area_name }}: "true"
# label.  Pods in the SAME namespace that need direct (non-LB) access to
# area-facing pods label themselves network/{{ _area_name }}-access:
# "true" (the access-egress policy's podSelector has no namespaceSelector,
# so it matches only the same namespace).
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-{{ _area_name }}-ingress
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector:
    matchLabels:
      network/{{ _area_name }}: "true"
  policyTypes:
  - Ingress
  ingress:
  - from:
  {% for cidr in _area.cidrs %}
    - ipBlock:
        cidr: {{ cidr }}
  {% endfor %}
    - podSelector:
        matchLabels:
          network/{{ _area_name }}-access: "true"
---
# {{ _area_name }}: egress for pods with access label -> area-facing pods
# and CIDRs
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-{{ _area_name }}-access-egress
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector:
    matchLabels:
      network/{{ _area_name }}-access: "true"
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector:
        matchLabels:
          network/{{ _area_name }}: "true"
  {% for cidr in _area.cidrs %}
    - ipBlock:
        cidr: {{ cidr }}
  {% endfor %}
{% endif %}
{% endfor %}
{% for _vlan_name, _vlan in (_np_cfg.service_vlans | default({})).items() %}
{% if _vlan.vlan is defined %}
{% set _vlan_cidrs = dhcp_networks[_vlan.vlan].subnets | list %}
{% elif _vlan.cidrs is defined %}
{% set _vlan_cidrs = _vlan.cidrs %}
{% elif _vlan.cidr is defined %}
{% set _vlan_cidrs = [_vlan.cidr] %}
{% else %}
{% set _vlan_cidrs = [] %}
{% endif %}
{% set _vlan_ns = _vlan.namespace | default('') %}
{% if _vlan_ns %}
---
# {{ _vlan_name }}: egress for access-labeled pods -> zone namespace.
# Namespace-defined zone: the zone target is the namespace {{ _vlan_ns }}
# (all pods in it), not a set of VLAN CIDRs; pods opt in with the
# network/{{ _vlan_name }}-access label.  VLAN CIDRs, when also configured,
# are allowed in the same rules.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-{{ _vlan_name }}-access-egress
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector:
    matchLabels:
      network/{{ _vlan_name }}-access: "true"
  policyTypes:
  - Egress
  egress:
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ _vlan_ns }}
  {% for cidr in _vlan_cidrs %}
    - ipBlock:
        cidr: {{ cidr }}
  {% endfor %}
{% if _namespace == _vlan_ns %}
---
# {{ _vlan_name }} zone namespace: all pods reachable from access-labeled
# pods.  Rendered only inside the zone namespace once it is managed;
# namespaceSelector: {} + podSelector = access-labeled pods from ANY
# namespace.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-{{ _vlan_name }}-ingress
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  ingress:
  - from:
    - namespaceSelector: {}
      podSelector:
        matchLabels:
          network/{{ _vlan_name }}-access: "true"
  {% for cidr in _vlan_cidrs %}
    - ipBlock:
        cidr: {{ cidr }}
  {% endfor %}
---
# {{ _vlan_name }} zone namespace: intra-namespace traffic.
# Multi-pod workloads (e.g. the rabbitmq nodes talking 5672/25672 to each
# other) need bidirectional same-namespace access, and the regular template
# has no allow-intra-namespace, so namespace-defined zones provide their
# own.  Reply traffic of allowed connections is conntrack-permitted anyway.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-{{ _vlan_name }}-intra
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  - Egress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ _vlan_ns }}
  egress:
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ _vlan_ns }}
{% endif %}
{% else %}
{% if _vlan_cidrs | length > 0 %}
---
# {{ _vlan_name }}: ingress from VLAN CIDRs + from same-namespace pods with
# the access label
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-{{ _vlan_name }}-ingress
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector:
    matchLabels:
      network/{{ _vlan_name }}: "true"
  policyTypes:
  - Ingress
  ingress:
  - from:
  {% for cidr in _vlan_cidrs %}
    - ipBlock:
        cidr: {{ cidr }}
  {% endfor %}
    - podSelector:
        matchLabels:
          network/{{ _vlan_name }}-access: "true"
---
# {{ _vlan_name }}: egress for access-labeled pods -> same-namespace pods
# and VLAN CIDRs.
# The first egress target is a podSelector without namespaceSelector, so it
# matches only pods in THIS namespace (see the access-areas note near the
# top of this template).  Cross-namespace reachability comes from the zone
# namespace's own allow-{{ _vlan_name }}-ingress policy, not from this one.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-{{ _vlan_name }}-access-egress
  namespace: {{ _namespace }}
  labels:
    configurator: ansible
    app.kubernetes.io/managed-by: k3s
  annotations:
    ansible.run-id: "{{ansible_run_id|default('N/A')}}"
    ansible.config_file: "{{ansible_config_file|default('N/A')}}"
    ansible.version: "{{ansible_version.full}}"
spec:
  podSelector:
    matchLabels:
      network/{{ _vlan_name }}-access: "true"
  policyTypes:
  - Egress
  egress:
  - to:
    - podSelector:
        matchLabels:
          network/{{ _vlan_name }}: "true"
  {% for cidr in _vlan_cidrs %}
    - ipBlock:
        cidr: {{ cidr }}
  {% endfor %}
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}