#!/bin/bash
# Pull longhorn release files from GitHub into files/longhorn/. Takes one or
# more versions (tag or plain, e.g. "v1.13.0"):
#
#   ./pull-longhorn-files v1.12.1 v1.13.0
#
# Per version: longhorn-<ver>.yaml (the deploy manifest -- deploy_longhorn.yml
# picks it via _k3s_cfg.longhorn.manifest) and images-<ver>.txt (image list for
# save-images.sh / load-images.sh -l; the list differs per release).
# uninstall.yaml (remove_longhorn.yml) is a single fixed file since that task
# hardcodes the name -- it is fetched from the LAST version given.
# save-images.sh/load-images.sh are fetched once: they are version-independent
# upstream helpers.
# No environment_check.sh: upstream deleted the script (gone from master and
# every release tree we pull); do not re-add the fetch.

set -e
cd "$(dirname "$0")"

if [[ $# -lt 1 ]]; then
    echo "usage: $0 vX.Y.Z [vX.Y.Z ...]" >&2
    exit 1
fi

dir=files/longhorn
last=${!#}
for tag in "$@"; do
    ver=${tag#v}
    url=https://raw.githubusercontent.com/longhorn/longhorn/${tag}
    wget -O ${dir}/longhorn-${ver}.yaml ${url}/deploy/longhorn.yaml
    wget -O ${dir}/images-${ver}.txt ${url}/deploy/longhorn-images.txt
done

url=https://raw.githubusercontent.com/longhorn/longhorn/${last}
wget -O ${dir}/uninstall.yaml ${url}/uninstall/uninstall.yaml
wget -O ${dir}/save-images.sh ${url}/scripts/save-images.sh
wget -O ${dir}/load-images.sh ${url}/scripts/load-images.sh
